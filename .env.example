# VELQIRIS Open Agent 2026 environment configuration

# Zetaris: choose one authentication mode.
ZETARIS_REST_URL=http://localhost:3000

# Official local event bundle (do not commit real values):
ZETARIS_ADMIN_EMAIL=admin@example.invalid
ZETARIS_ADMIN_PASSWORD=replace-me

# Bearer deployment alternative:
ZETARIS_API_KEY=
ZETARIS_ORG_ID=

# Optional external model adapter. No model output is claimed by this release.
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_API_KEY=
NEMOTRON_MODEL=

# Local project settings.
METERLESS_ENABLED=true
METERLESS_PROMPT_ID=market_truth_explain_why
METERLESS_STORE_PATH=.velqiris/hmem-python-profile
COST_PER_QUERY_LIMIT_USD=0.05
FAIL_CLOSED=true
