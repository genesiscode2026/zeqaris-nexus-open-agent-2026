{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZEQARIS NEXUS Comprehensive Golden Test Vectors Suite",
  "version": "1.4.0",
  "specification": "ZEQARIS-JCS-1 (RFC 8785) & EIP-712 Settlement Voucher",
  "unicode_jcs_vectors": {
    "positive": [
      {
        "id": "JCS_POS_01_SURROGATE_PAIR_EMOJI",
        "description": "Valid UTF-8 surrogate pair (emoji \ud83d\udc1d U+1F41D)",
        "payload": "{\"status\":\"active\",\"symbol\":\"\ud83d\udc1d\"}",
        "expected_canonical_bytes_hex": "7b22737461747573223a22616374697665222c2273796d626f6c223a22f09f909d227d"
      },
      {
        "id": "JCS_POS_02_QUOTE_AND_BACKSLASH",
        "description": "Escaped quotes and backslashes preserved under RFC 8785",
        "payload": "{\"path\":\"C:\\\\secure\\\\vault\",\"quote\":\"\\\"verified\\\"\"}",
        "expected_canonical_bytes_hex": "7b2270617468223a22433a5c5c7365637572655c5c7661756c74222c2271756f7465223a225c2276657269666965645c22227d"
      },
      {
        "id": "JCS_POS_03_UTF16_KEY_ORDERING",
        "description": "Key ordering strictly follows UTF-16 code units (RFC 8785 Section 3.2.3)",
        "input_keys": [
          "\u00e9",
          "e",
          "\ud83d\ude00",
          "z"
        ],
        "expected_sorted_keys": [
          "e",
          "z",
          "\u00e9",
          "\ud83d\ude00"
        ]
      },
      {
        "id": "JCS_POS_04_NON_BMP_SURROGATE_UTF16_ORDER",
        "description": "Non-BMP character U+1F600 (surrogate pair D83D DE00) sorts BEFORE BMP character U+E000 under UTF-16 code units",
        "input_keys": [
          "\ue000",
          "\ud83d\ude00"
        ],
        "expected_sorted_keys": [
          "\ud83d\ude00",
          "\ue000"
        ]
      }
    ],
    "negative": [
      {
        "id": "JCS_NEG_01_FLOAT_FORBIDDEN",
        "input": "{\"amount\":10.5}",
        "expected_error": "Floating point numbers are forbidden in ZEQARIS-JCS-1 profile"
      },
      {
        "id": "JCS_NEG_02_NEGATIVE_ZERO",
        "input": "{\"nonce\":-0}",
        "expected_error": "Negative zero is forbidden"
      },
      {
        "id": "JCS_NEG_03_EXPONENT",
        "input": "{\"budget\":1e6}",
        "expected_error": "Exponents are forbidden in ZEQARIS-JCS-1 profile"
      },
      {
        "id": "JCS_NEG_04_DUPLICATE_KEYS",
        "input": "{\"key\":1,\"key\":2}",
        "expected_error": "Duplicate keys rejected"
      }
    ]
  },
